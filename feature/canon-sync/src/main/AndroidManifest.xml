<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network — install-time -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Required for SSDP multicast on the camera AP — otherwise the Wi-Fi
         chip drops 239.255.255.250 packets to save power. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Wi-Fi peer discovery + accurate subnet sweep. We do NOT cap with
         maxSdkVersion any more: location is still useful on API 33+ for
         WifiManager.getScanResults() (which returns empty without it on
         most OEMs) and for accurate gateway/subnet detection through
         WifiManager.getConnectionInfo(). Matches Canon Camera Connect's
         declared set (jp.co.canon.ic.cameraconnect). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lets FOREGROUND_SERVICE_LOCATION continue receiving Wi-Fi scan
         updates while the app is in the background during long pairs. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Wi-Fi peer discovery — runtime-prompted on API ≥33. With this set,
         the Wi-Fi scan no longer requires the location runtime grant on
         T+ devices, but we keep FINE_LOCATION declared so older devices
         and OEM forks still work. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Bluetooth discovery / pairing path (some Canon bodies advertise via
         BLE before handing off to Wi-Fi). Declared so future BT-trigger
         flows can compile-in without re-prompting. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- NFC tap-to-pair. Canon bodies (R-series, M-series) write a small
         pairing payload to NFC; declaring the permission lets us read it. -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- In-app QR-pair (scan the camera's on-screen QR for IP+pair-key). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Post background notifications (runtime on API 33+). Already declared
         by core:data via manifest merge but listed here so it's explicit
         for the Canon Sync capture-coordinator FGS persistent notif. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Allow location-typed foreground service so Wi-Fi scan results
         keep flowing while the user briefly leaves the app to flip the
         camera's Wi-Fi switch during a long pair attempt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Draw a small progress bubble on top of OTHER apps while a
         Canon Sync Download & Process pipeline is in flight. The user
         must grant this via Settings.canDrawOverlays() — we surface
         the prompt only when they explicitly opt in from the batch
         screen, never automatically. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service runtime + transient wake lock for in-flight transfers.
         FOREGROUND_SERVICE / FOREGROUND_SERVICE_DATA_SYNC / POST_NOTIFICATIONS
         are already declared by core:data via manifest merging. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 14+ requires per-type FGS permissions. We use
         FOREGROUND_SERVICE_CONNECTED_DEVICE because the Canon Sync session
         is, semantically, "talk to a Wi-Fi-connected camera accessory" —
         the most accurate of the documented FGS types for our workload.
         dataSync is also declared (already via core:data manifest merge)
         so we can fall back to that mode on devices/OEMs where the
         connectedDevice type is restricted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Optional: direct battery-optimization exemption dialog (Play-policy
         restricted; we prefer the gentler ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS
         flow but keep this declared so the direct-request path is usable). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!-- Canon Sync is reached via the main-page card / navigation graph in
             feature:root, not as a standalone Activity. -->

        <service
            android:name=".service.CanonSyncCaptureService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync|location"
            android:stopWithTask="false" />

        <!-- Floating progress bubble (Display over other apps). Not an
             FGS — its lifecycle is bounded by the parent pipeline FGS. -->
        <service
            android:name=".service.CanonSyncOverlayService"
            android:exported="false" />
    </application>

</manifest>
