<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application tools:targetApi="tiramisu">
        <!--
          ~ Quick Settings tiles removed by request — every tool is reached from
          ~ inside the app (Color Picker, Edit/Take Screenshot, QR, Document
          ~ Scanner, Recognize Text/OCR, Resize & Convert, Generate Palette).
          ~ The screenshot Activity/Service below are NOT tiles; they stay so the
          ~ in-app screen-capture path keeps working.
        -->

        <activity
            android:name=".screenshot.ScreenshotLauncher"
            android:exported="false"
            android:theme="@style/TransparentActivity" />

        <service
            android:name=".screenshot.ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:process=":remote" />
    </application>
</manifest>