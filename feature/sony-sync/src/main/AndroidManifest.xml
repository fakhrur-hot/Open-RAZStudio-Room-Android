<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network — install-time. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- SSDP/UPnP device discovery on the camera SoftAP (239.255.255.250).
         The A7 II's "Send to Smartphone" is discovered via SSDP M-SEARCH, so
         without a multicast lock the Wi-Fi chip drops the packets. Confirmed by
         the PlayMemories capture (acquireMulticastLock lockTag=upnp-device-finder). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Wi-Fi scan / accurate subnet + gateway detection on the camera link. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Wi-Fi peer discovery — runtime-prompted on API >=33. Lets us join and
         scan the Sony SoftAP without the location grant on Tiramisu+. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- NFC one-touch: the A7 II N-Mark exposes an NDEF tag carrying the Wi-Fi
         SSID/passphrase. Android Beam is gone since API 29, so we read the tag
         via NfcAdapter reader-mode; this permission lets us receive it.
         Confirmed by the capture: NfcService onRemoteEndpointDiscovered. -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Post background notifications (runtime on API 33+) for the transfer FGS. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 14+ per-type FGS: the Sony Sync session is "talk to a
         Wi-Fi-connected camera accessory", so connectedDevice is the accurate
         type. Mirrors feature:canon-sync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application>
        <!-- Sony Sync is reached via the main-page card / navigation graph in
             feature:root, not as a standalone Activity. The UPnP/SSDP transfer
             service (parallel to CanonSyncCaptureService) will be added here
             when the retrieval engine lands. -->
    </application>

</manifest>
