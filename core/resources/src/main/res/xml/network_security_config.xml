<!--
   Allows cleartext HTTP traffic. This is currently required for local camera
   communication (e.g., Canon PTP/IP over Wi-Fi). Prefer narrowing this to
   specific domains/IPs once those are known.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
